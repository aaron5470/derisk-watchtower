# DeRisk Watchtower Subgraph - Environment Configuration

# Deployed Contract Addresses (Base Sepolia)
# IMPORTANT: Update these after deploying E1 contracts
POSITION_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
PROTECTOR_ADDRESS=0x0000000000000000000000000000000000000000
DEMO_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# Deployment Block Numbers
# IMPORTANT: Update with actual deployment block numbers to optimize indexing
POSITION_VAULT_START_BLOCK=0
PROTECTOR_START_BLOCK=0
DEMO_ESCROW_START_BLOCK=0

# Network Configuration
NETWORK=base-sepolia
RPC_URL=https://sepolia.base.org

# The Graph Configuration
# Get your access token from: https://thegraph.com/studio/
GRAPH_ACCESS_TOKEN=your_graph_access_token_here
SUBGRAPH_NAME=derisk-watchtower

# Local Development (optional)
LOCAL_GRAPH_NODE=http://localhost:8020/
LOCAL_IPFS_NODE=http://localhost:5001

# BaseScan API Key (for contract verification)
BASESCAN_API_KEY=your_basescan_api_key_here
