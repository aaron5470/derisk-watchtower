{
  "dashboard": {
    "title": "Automation Alerts & Notifications",
    "description": "Alert rules and notification channels for Chainlink Automation monitoring",
    "tags": ["alerts", "automation", "notifications"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "1m",
    "panels": [
      {
        "id": 1,
        "title": "Active Alerts",
        "type": "alertlist",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "options": {
          "showOptions": "current",
          "maxItems": 20,
          "sortOrder": 1,
          "dashboardAlerts": false,
          "alertInstanceLabelFilter": "",
          "folder": "",
          "stateFilter": {
            "firing": true,
            "pending": true,
            "noData": false,
            "normal": false
          }
        }
      }
    ]
  },
  "overwrite": true,
  "alertRules": [
    {
      "uid": "automation_delay_alert",
      "title": "Automation Delay Critical",
      "condition": "A",
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "model": {
            "expr": "automation_delay_seconds > 600",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "A"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Alerting",
      "for": "5m",
      "annotations": {
        "description": "Chainlink Automation delay has exceeded 10 minutes. This indicates potential issues with the automation upkeep.",
        "runbook_url": "https://docs.chain.link/chainlink-automation/troubleshooting",
        "summary": "Automation delay is critically high"
      },
      "labels": {
        "severity": "critical",
        "component": "automation",
        "team": "defi"
      }
    },
    {
      "uid": "automation_unhealthy_alert",
      "title": "Automation System Unhealthy",
      "condition": "A",
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "model": {
            "expr": "automation_healthy == 0",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "A"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Alerting",
      "for": "2m",
      "annotations": {
        "description": "The automation system is reporting an unhealthy status. Check the automation service logs and Chainlink Automation upkeep status.",
        "runbook_url": "https://docs.chain.link/chainlink-automation/troubleshooting",
        "summary": "Automation system health check failed"
      },
      "labels": {
        "severity": "critical",
        "component": "automation",
        "team": "defi"
      }
    },
    {
      "uid": "automation_no_triggers_alert",
      "title": "No Automation Triggers",
      "condition": "A",
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 3600,
            "to": 0
          },
          "model": {
            "expr": "increase(automation_triggers_total[1h]) == 0",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "A"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Alerting",
      "for": "30m",
      "annotations": {
        "description": "No automation triggers have been recorded in the last hour. This could indicate issues with position monitoring or automation configuration.",
        "runbook_url": "https://docs.chain.link/chainlink-automation/troubleshooting",
        "summary": "Automation triggers have stopped"
      },
      "labels": {
        "severity": "warning",
        "component": "automation",
        "team": "defi"
      }
    },
    {
      "uid": "automation_high_failure_rate_alert",
      "title": "High Automation Failure Rate",
      "condition": "A",
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "model": {
            "expr": "rate(automation_failure_total[5m]) / (rate(automation_success_total[5m]) + rate(automation_failure_total[5m])) > 0.2",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "A"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Alerting",
      "for": "10m",
      "annotations": {
        "description": "Automation failure rate has exceeded 20% over the last 15 minutes. Check automation service logs and contract interactions.",
        "runbook_url": "https://docs.chain.link/chainlink-automation/troubleshooting",
        "summary": "High automation failure rate detected"
      },
      "labels": {
        "severity": "warning",
        "component": "automation",
        "team": "defi"
      }
    },
    {
      "uid": "automation_service_down_alert",
      "title": "Automation Service Down",
      "condition": "A",
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "model": {
            "expr": "up{job=\"automation-service\"} == 0",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "A"
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "for": "1m",
      "annotations": {
        "description": "The automation service is down or unreachable. This will prevent automation from functioning properly.",
        "runbook_url": "https://docs.chain.link/chainlink-automation/troubleshooting",
        "summary": "Automation service is not responding"
      },
      "labels": {
        "severity": "critical",
        "component": "automation",
        "team": "defi"
      }
    }
  ],
  "notificationChannels": [
    {
      "name": "automation-alerts",
      "type": "slack",
      "settings": {
        "url": "${SLACK_WEBHOOK_URL}",
        "channel": "#defi-alerts",
        "username": "Grafana",
        "title": "DeRisk Watchtower Alert",
        "text": "{{ range .Alerts }}{{ .Annotations.summary }}\n{{ .Annotations.description }}{{ end }}",
        "iconEmoji": ":warning:",
        "color": "danger"
      }
    },
    {
      "name": "automation-email",
      "type": "email",
      "settings": {
        "addresses": "${ALERT_EMAIL_ADDRESSES}",
        "subject": "DeRisk Watchtower Automation Alert",
        "body": "{{ range .Alerts }}Alert: {{ .Annotations.summary }}\nDescription: {{ .Annotations.description }}\nSeverity: {{ .Labels.severity }}{{ end }}"
      }
    },
    {
      "name": "automation-webhook",
      "type": "webhook",
      "settings": {
        "url": "${WEBHOOK_URL}",
        "httpMethod": "POST",
        "maxAlerts": 0,
        "title": "DeRisk Watchtower Alert",
        "message": "{{ range .Alerts }}{{ .Annotations.summary }}: {{ .Annotations.description }}{{ end }}"
      }
    }
  ]
}